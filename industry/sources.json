{
  "$comment": "RelayWatch 示范信源。首次启动时导入（scripts/seed.ts），已存在的不会被覆盖。每条 URL 均在 2026-10-01 用 HTTP 请求核对过。不收录本站审计推送。缺口写在拉取请求说明里：zzzl.ist 没有公开帖子列表或 RSS；没有可抓的社区 Telegram 讨论组；NodeSeek 只有全站 RSS；OpenAI 定价页 403；Gemini 更新日志没有逐条链接。",
  "sources": [
    {
      "id": "json-yunwu-announcements",
      "name": "云雾 API 公告",
      "kind": "json_list",
      "config": {
        "url": "https://yunwu.ai/api/status",
        "itemsPath": "data.announcements",
        "titlePaths": ["content"],
        "summaryPaths": ["content"],
        "summaryIsBody": true,
        "publishedAtPath": "publishDate",
        "urlTemplate": "https://yunwu.ai/#notice-{translation_hash}",
        "preserveUrlFragment": true,
        "rawDropKeys": ["translations"],
        "_aihot": { "initialBackfillLimit": 8 }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "tags": ["官方", "公告"],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
